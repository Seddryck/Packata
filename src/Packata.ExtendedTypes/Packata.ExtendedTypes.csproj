<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Description>Optional NetTopologySuite and Chrononuensis CLR representations and reader bindings for Packata.</Description>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Packata.ResourceReaders\Packata.ResourceReaders.csproj" />
    <PackageReference Include="PocketCsvReader.Chrononuensis" Version="2.89.1" />
    <PackageReference Include="PocketCsvReader.NetTopologySuite" Version="2.89.1" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="Packata.ExtendedTypes.readerbindings.json"
             Link="Packata.ReaderBindings/Packata.ExtendedTypes.readerbindings.json"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest"
             Pack="true" PackagePath="buildTransitive" />
    <None Include="Packata.ExtendedTypes.targets" Pack="true" PackagePath="buildTransitive" />
  </ItemGroup>
</Project>

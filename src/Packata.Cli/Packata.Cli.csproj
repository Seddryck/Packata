<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RuntimeIdentifiers>$(CliToolRuntimeIdentifiers)</RuntimeIdentifiers>
    <ToolPackageRuntimeIdentifiers>$(RuntimeIdentifiers)</ToolPackageRuntimeIdentifiers>
    <AssemblyName>packata</AssemblyName>
    <RootNamespace>Packata.Cli</RootNamespace>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>packata</ToolCommandName>
    <PackageId>Packata-cli</PackageId>
    <PackageIcon>icon/Packata-icon-128.png</PackageIcon>
    <Description>Cross-platform command-line interface for Packata.</Description>
    <PublishAot>false</PublishAot>
    <PublishTrimmed>false</PublishTrimmed>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Spectre.Console.Cli" Version="0.57.2" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
    <PackageReference Include="YamlDotNet" Version="18.1.0" />
    <PackageReference Include="JsonSchema.Net" Version="9.4.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Packata.Documents\Packata.Documents.csproj" />
    <ProjectReference Include="..\Packata.OpenDataContract\Packata.OpenDataContract.csproj" />
    <ProjectReference Include="..\Packata.ResourceReaders\Packata.ResourceReaders.csproj" />
    <ProjectReference Include="..\Packata.ResourceReaders.Database\Packata.ResourceReaders.Database.csproj" />
    <ProjectReference Include="..\Packata.ResourceReaders.Excel\Packata.ResourceReaders.Excel.csproj" />
    <ProjectReference Include="..\Packata.ResourceReaders.Parquet\Packata.ResourceReaders.Parquet.csproj" />
    <ProjectReference Include="..\Packata.Storages\Packata.Storages.csproj" />
    <ProjectReference Include="..\Packata.Rules.Sql\Packata.Rules.Sql.csproj" />
    <ProjectReference Include="..\Packata.Rules.Expressif\Packata.Rules.Expressif.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Update="../../assets/Packata-icon-128.png" PackagePath="icon/" />
    <None Update="../../README.md" PackagePath="/" />
  </ItemGroup>

  <ItemGroup>
    <!-- Pinned from https://github.com/Seddryck/DubUrl/releases/tag/v0.46.0. -->
    <EmbeddedResource Include="Resources/connector-catalog-0.46.0.json" LogicalName="Packata.Cli.ConnectorCatalog" />
    <EmbeddedResource Include="Resources/oors-json-schema-v0.8.0.json" LogicalName="Packata.Cli.OorsSchema" />
    <InternalsVisibleTo Include="Packata.Cli.Testing" />
  </ItemGroup>

</Project>

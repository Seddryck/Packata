<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RuntimeIdentifiers>win-x64;win-arm64;linux-x64;linux-arm64;linux-musl-x64;linux-musl-arm64;osx-x64;osx-arm64</RuntimeIdentifiers>
    <ToolPackageRuntimeIdentifiers>$(RuntimeIdentifiers)</ToolPackageRuntimeIdentifiers>
    <AssemblyName>packata</AssemblyName>
    <RootNamespace>Packata.Cli</RootNamespace>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>packata</ToolCommandName>
    <PackageId>Packata-cli</PackageId>
    <PackageIcon>icon/Packata-icon-128.png</PackageIcon>
    <Description>Cross-platform command-line interface for Packata.</Description>
    <PublishAot>false</PublishAot>
    <PublishTrimmed>false</PublishTrimmed>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Spectre.Console.Cli" Version="0.57.2" />
  </ItemGroup>

  <ItemGroup>
    <None Update="../../assets/Packata-icon-128.png" PackagePath="icon/" />
    <None Update="../../README.md" PackagePath="/" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Packata.Cli.Testing" />
  </ItemGroup>

</Project>

###############################################################################
# Define language based on file's extension
###############################################################################
*.st linguist-language=StringTemplate
*.stg linguist-language=StringTemplate

###############################################################################
# Set default behavior to automatically normalize line endings.
###############################################################################
* text=auto

# The sample descriptor explicitly declares LF as its CSV record terminator.
docs/samples/quickstart/customers.csv text eol=lf

# Official schema artifacts are pinned byte-for-byte, including their SHA-256.
src/Packata.Documents/Validation/Schemas/*.json -text

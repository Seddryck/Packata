{
  "name": "packata-language-support",
  "displayName": "Packata Language Support",
  "description": "ODCS and Data Package navigation and validation through Packata.LanguageServer.",
  "version": "0.1.0",
  "publisher": "seddryck",
  "license": "Apache-2.0",
  "icon": "images/packata-icon-128.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/Seddryck/Packata.git",
    "directory": "vscode-extension"
  },
  "engines": {
    "vscode": "^1.137.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "files": [
    "dist/extension.js",
    "server/**",
    "images/**",
    "README.md",
    "LICENSE"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false
    },
    "virtualWorkspaces": false
  },
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "packata",
          "title": "Packata",
          "icon": "images/packata.svg"
        }
      ]
    },
    "views": {
      "packata": [
        {
          "id": "packata.contracts",
          "name": "Data Contracts"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "packata.contracts",
        "contents": "Open a folder containing ODCS or Data Package v2 descriptors.\n[Refresh contracts](command:packata.refresh)"
      }
    ],
    "commands": [
      {
        "command": "packata.refresh",
        "title": "Refresh Contracts",
        "category": "Packata",
        "icon": "$(refresh)"
      },
      {
        "command": "packata.restart",
        "title": "Restart Language Server",
        "category": "Packata"
      },
      {
        "command": "packata.openSource",
        "title": "Open Source",
        "category": "Packata"
      },
      {
        "command": "packata.inspect",
        "title": "Inspect Contract",
        "category": "Packata"
      },
      {
        "command": "packata.validate",
        "title": "Validate…",
        "category": "Packata"
      },
      {
        "command": "packata.copyPath",
        "title": "Copy Logical Path",
        "category": "Packata"
      },
      {
        "command": "packata.selectView",
        "title": "View as: Canonical / Native",
        "category": "Packata",
        "icon": "$(list-tree)"
      },
      {
        "title": "Run Last Validation",
        "icon": "$(checklist)",
        "command": "packata.runLastValidation",
        "category": "Packata"
      },
      {
        "command": "packata.preview",
        "title": "Preview Resource Data…",
        "category": "Packata",
        "icon": "$(table)"
      },
      {
        "command": "packata.generateSchemaCode",
        "category": "Packata",
        "icon": "$(code)",
        "title": "Generate Schema Code…"
      },
      {
        "command": "packata.exportSchema",
        "title": "Export Schema…",
        "category": "Packata"
      },
      {
        "command": "packata.schema.custom",
        "title": "Custom Template…",
        "category": "Packata"
      },
      {
        "command": "packata.schema.jsonSchema",
        "title": "JSON Schema…",
        "category": "Packata",
        "enablement": "packata.schema.jsonSchema"
      },
      {
        "command": "packata.schema.record",
        "title": "Record…",
        "category": "Packata",
        "enablement": "packata.schema.record"
      },
      {
        "command": "packata.schema.datatable",
        "title": "DataTable…",
        "category": "Packata",
        "enablement": "packata.schema.datatable"
      },
      {
        "command": "packata.schema.polars",
        "title": "Polars.NET…",
        "category": "Packata",
        "enablement": "packata.schema.polars"
      },
      {
        "command": "packata.schema.sql.ansi",
        "title": "ANSI SQL…",
        "category": "Packata",
        "enablement": "packata.schema.sql.ansi"
      },
      {
        "command": "packata.schema.sql.access",
        "title": "Access…",
        "category": "Packata",
        "enablement": "packata.schema.sql.access"
      },
      {
        "command": "packata.schema.sql.db2",
        "title": "Db2…",
        "category": "Packata",
        "enablement": "packata.schema.sql.db2"
      },
      {
        "command": "packata.schema.sql.duckdb",
        "title": "DuckDB…",
        "category": "Packata",
        "enablement": "packata.schema.sql.duckdb"
      },
      {
        "command": "packata.schema.sql.firebird",
        "title": "Firebird…",
        "category": "Packata",
        "enablement": "packata.schema.sql.firebird"
      },
      {
        "command": "packata.schema.sql.mysql",
        "title": "MySQL…",
        "category": "Packata",
        "enablement": "packata.schema.sql.mysql"
      },
      {
        "command": "packata.schema.sql.singlestore",
        "title": "SingleStore…",
        "category": "Packata",
        "enablement": "packata.schema.sql.singlestore"
      },
      {
        "command": "packata.schema.sql.oracle",
        "title": "Oracle…",
        "category": "Packata",
        "enablement": "packata.schema.sql.oracle"
      },
      {
        "command": "packata.schema.sql.cockroachdb",
        "title": "CockroachDB…",
        "category": "Packata",
        "enablement": "packata.schema.sql.cockroachdb"
      },
      {
        "command": "packata.schema.sql.cratedb",
        "title": "CrateDB…",
        "category": "Packata",
        "enablement": "packata.schema.sql.cratedb"
      },
      {
        "command": "packata.schema.sql.postgresql",
        "title": "PostgreSQL…",
        "category": "Packata",
        "enablement": "packata.schema.sql.postgresql"
      },
      {
        "command": "packata.schema.sql.snowflake",
        "title": "Snowflake…",
        "category": "Packata",
        "enablement": "packata.schema.sql.snowflake"
      },
      {
        "command": "packata.schema.sql.sqlite",
        "title": "SQLite…",
        "category": "Packata",
        "enablement": "packata.schema.sql.sqlite"
      },
      {
        "command": "packata.schema.sql.sqlserver",
        "title": "SQL Server…",
        "category": "Packata",
        "enablement": "packata.schema.sql.sqlserver"
      },
      {
        "command": "packata.schema.sql.teradata",
        "title": "Teradata…",
        "category": "Packata",
        "enablement": "packata.schema.sql.teradata"
      },
      {
        "command": "packata.schema.arrowIpc",
        "title": "Arrow IPC…",
        "category": "Packata",
        "enablement": "packata.schema.arrowIpc"
      },
      {
        "command": "packata.schema.avroIdl",
        "title": "Avro IDL…",
        "category": "Packata",
        "enablement": "packata.schema.avroIdl"
      },
      {
        "command": "packata.schema.avro",
        "title": "Avro…",
        "category": "Packata",
        "enablement": "packata.schema.avro"
      },
      {
        "command": "packata.schema.sparkJson",
        "title": "Spark JSON…",
        "category": "Packata",
        "enablement": "packata.schema.sparkJson"
      },
      {
        "command": "packata.schema.otherFormats",
        "title": "Other Formats…",
        "category": "Packata"
      },
      {
        "command": "packata.schema.otherTargets",
        "title": "Other Targets…",
        "category": "Packata"
      },
      {
        "command": "packata.schema.arrowCsharp",
        "title": "Arrow Schema…",
        "category": "Packata C#",
        "enablement": "packata.schema.arrowCsharp"
      },
      {
        "command": "packata.schema.pysparkPython",
        "title": "PySpark Schema…",
        "category": "Packata Python",
        "enablement": "packata.schema.pysparkPython"
      },
      {
        "command": "packata.schema.dataframeCsharp",
        "title": "DataFrame…",
        "category": "Packata C#",
        "enablement": "packata.schema.dataframeCsharp"
      },
      {
        "command": "packata.schema.idataviewCsharp",
        "title": "ML.NET Schema…",
        "category": "Packata C#",
        "enablement": "packata.schema.idataviewCsharp"
      },
      {
        "command": "packata.schema.arrowPython",
        "title": "Arrow Schema…",
        "category": "Packata Python",
        "enablement": "packata.schema.arrowPython"
      },
      {
        "command": "packata.schema.classCsharp",
        "title": "Class…",
        "category": "Packata C#",
        "enablement": "packata.schema.classCsharp"
      },
      {
        "command": "packata.schema.classPython",
        "title": "Class…",
        "category": "Packata Python",
        "enablement": "packata.schema.classPython"
      },
      {
        "command": "packata.schema.dataclassPython",
        "title": "Dataclass…",
        "category": "Packata Python",
        "enablement": "packata.schema.dataclassPython"
      },
      {
        "command": "packata.schema.pydanticPython",
        "title": "Pydantic Model…",
        "category": "Packata Python",
        "enablement": "packata.schema.pydanticPython"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "packata.refresh",
          "when": "view == packata.contracts",
          "group": "navigation"
        },
        {
          "command": "packata.selectView",
          "when": "view == packata.contracts",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "packata.openSource",
          "when": "view == packata.contracts",
          "group": "1_source"
        },
        {
          "command": "packata.inspect",
          "when": "view == packata.contracts && (viewItem == contract || viewItem == asset || viewItem == previewAsset)",
          "group": "2_contract"
        },
        {
          "command": "packata.validate",
          "when": "view == packata.contracts && (viewItem == contract || viewItem == asset || viewItem == previewAsset)",
          "group": "2_contract"
        },
        {
          "command": "packata.copyPath",
          "when": "view == packata.contracts",
          "group": "3_copy"
        },
        {
          "command": "packata.preview",
          "when": "view == packata.contracts && viewItem == previewAsset",
          "group": "2_contract"
        },
        {
          "submenu": "packata.schema.export",
          "when": "view == packata.contracts && (viewItem == contract || viewItem == asset || viewItem == previewAsset) && packata.schema.export",
          "group": "2_contract"
        },
        {
          "submenu": "packata.schema.generate",
          "when": "view == packata.contracts && (viewItem == contract || viewItem == asset || viewItem == previewAsset) && packata.schema.generate",
          "group": "2_contract"
        }
      ],
      "explorer/context": [
        {
          "when": "resourceScheme == file && (resourceExtname == .json || resourceExtname == .yaml || resourceExtname == .yml)",
          "command": "packata.validate",
          "group": "packata@1"
        },
        {
          "when": "resourceScheme == file && (resourceExtname == .json || resourceExtname == .yaml || resourceExtname == .yml)",
          "command": "packata.runLastValidation",
          "group": "packata@2"
        }
      ],
      "editor/context": [
        {
          "when": "resourceScheme == file && (resourceExtname == .json || resourceExtname == .yaml || resourceExtname == .yml)",
          "command": "packata.validate",
          "group": "packata@1"
        },
        {
          "when": "resourceScheme == file && (resourceExtname == .json || resourceExtname == .yaml || resourceExtname == .yml)",
          "command": "packata.runLastValidation",
          "group": "packata@2"
        }
      ],
      "packata.schema.export": [
        {
          "command": "packata.schema.arrowIpc",
          "when": "packata.schema.arrowIpc"
        },
        {
          "command": "packata.schema.sparkJson",
          "when": "packata.schema.sparkJson"
        },
        {
          "command": "packata.schema.avroIdl",
          "when": "packata.schema.avroIdl"
        },
        {
          "command": "packata.schema.avro",
          "when": "packata.schema.avro"
        },
        {
          "command": "packata.schema.jsonSchema",
          "when": "packata.schema.jsonSchema"
        },
        {
          "command": "packata.schema.otherFormats",
          "when": "packata.schema.other.export"
        }
      ],
      "packata.schema.csharp": [
        {
          "command": "packata.schema.dataframeCsharp",
          "when": "packata.schema.dataframeCsharp"
        },
        {
          "command": "packata.schema.idataviewCsharp",
          "when": "packata.schema.idataviewCsharp"
        },
        {
          "command": "packata.schema.record",
          "when": "packata.schema.record"
        },
        {
          "command": "packata.schema.datatable",
          "when": "packata.schema.datatable"
        },
        {
          "command": "packata.schema.polars",
          "when": "packata.schema.polars"
        },
        {
          "command": "packata.schema.arrowCsharp",
          "when": "packata.schema.arrowCsharp"
        },
        {
          "command": "packata.schema.classCsharp",
          "when": "packata.schema.classCsharp"
        }
      ],
      "packata.schema.generate": [
        {
          "submenu": "packata.schema.csharp",
          "when": "packata.schema.csharp"
        },
        {
          "submenu": "packata.schema.python",
          "when": "packata.schema.python"
        },
        {
          "submenu": "packata.schema.sql",
          "when": "packata.schema.sql"
        },
        {
          "command": "packata.schema.custom"
        },
        {
          "command": "packata.schema.otherTargets",
          "when": "packata.schema.other.generate"
        }
      ],
      "packata.schema.sql": [
        {
          "command": "packata.schema.sql.ansi",
          "when": "packata.schema.sql.ansi"
        },
        {
          "command": "packata.schema.sql.access",
          "when": "packata.schema.sql.access"
        },
        {
          "command": "packata.schema.sql.db2",
          "when": "packata.schema.sql.db2"
        },
        {
          "command": "packata.schema.sql.duckdb",
          "when": "packata.schema.sql.duckdb"
        },
        {
          "command": "packata.schema.sql.firebird",
          "when": "packata.schema.sql.firebird"
        },
        {
          "command": "packata.schema.sql.mysql",
          "when": "packata.schema.sql.mysql"
        },
        {
          "command": "packata.schema.sql.singlestore",
          "when": "packata.schema.sql.singlestore"
        },
        {
          "command": "packata.schema.sql.oracle",
          "when": "packata.schema.sql.oracle"
        },
        {
          "command": "packata.schema.sql.cockroachdb",
          "when": "packata.schema.sql.cockroachdb"
        },
        {
          "command": "packata.schema.sql.cratedb",
          "when": "packata.schema.sql.cratedb"
        },
        {
          "command": "packata.schema.sql.postgresql",
          "when": "packata.schema.sql.postgresql"
        },
        {
          "command": "packata.schema.sql.snowflake",
          "when": "packata.schema.sql.snowflake"
        },
        {
          "command": "packata.schema.sql.sqlite",
          "when": "packata.schema.sql.sqlite"
        },
        {
          "command": "packata.schema.sql.sqlserver",
          "when": "packata.schema.sql.sqlserver"
        },
        {
          "command": "packata.schema.sql.teradata",
          "when": "packata.schema.sql.teradata"
        }
      ],
      "packata.schema.python": [
        {
          "command": "packata.schema.pysparkPython",
          "when": "packata.schema.pysparkPython"
        },
        {
          "command": "packata.schema.arrowPython",
          "when": "packata.schema.arrowPython"
        },
        {
          "command": "packata.schema.classPython",
          "when": "packata.schema.classPython"
        },
        {
          "command": "packata.schema.dataclassPython",
          "when": "packata.schema.dataclassPython"
        },
        {
          "command": "packata.schema.pydanticPython",
          "when": "packata.schema.pydanticPython"
        }
      ]
    },
    "configuration": {
      "title": "Packata",
      "properties": {
        "packata.languageServer.path": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "description": "Optional absolute development server executable path. Empty uses the bundled self-contained server."
        },
        "packata.requestTimeout": {
          "type": "number",
          "default": 30000,
          "minimum": 1000,
          "description": "Maximum server request time in milliseconds."
        }
      }
    },
    "submenus": [
      {
        "id": "packata.schema.export",
        "label": "Export Schema"
      },
      {
        "id": "packata.schema.generate",
        "label": "Generate Schema Code"
      },
      {
        "id": "packata.schema.csharp",
        "label": "C#"
      },
      {
        "id": "packata.schema.python",
        "label": "Python"
      },
      {
        "id": "packata.schema.sql",
        "label": "SQL"
      }
    ]
  },
  "scripts": {
    "check": "tsc --noEmit",
    "compile": "npm run check && esbuild src/extension.ts --bundle --external:vscode --platform=node --format=cjs --outfile=dist/extension.js",
    "test": "node --test test/*.test.cjs",
    "package": "npm run compile && node scripts/package.mjs",
    "test:host": "node scripts/test-host.mjs"
  },
  "dependencies": {
    "vscode-languageclient": "10.1.1"
  },
  "devDependencies": {
    "@types/node": "26.5.1",
    "@types/vscode": "1.137.0",
    "@vscode/test-electron": "3.1.0",
    "@vscode/vsce": "3.9.2",
    "esbuild": "0.28.2",
    "typescript": "7.0.2",
    "yauzl": "3.4.0"
  },
  "overrides": {
    "@azure/identity": "4.13.0",
    "uuid": "11.1.1"
  }
}

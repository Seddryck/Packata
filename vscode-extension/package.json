{
  "name": "packata-language-support",
  "displayName": "Packata Language Support",
  "description": "ODCS and Data Package navigation and validation through Packata.LanguageServer.",
  "version": "0.1.0",
  "publisher": "seddryck",
  "license": "Apache-2.0",
  "icon": "images/packata-icon-128.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/Seddryck/Packata.git",
    "directory": "vscode-extension"
  },
  "engines": {
    "vscode": "^1.137.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "files": [
    "dist/extension.js",
    "server/**",
    "images/**",
    "README.md",
    "LICENSE"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false
    },
    "virtualWorkspaces": false
  },
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "packata",
          "title": "Packata",
          "icon": "images/packata.svg"
        }
      ]
    },
    "views": {
      "packata": [
        {
          "id": "packata.contracts",
          "name": "Data Contracts"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "packata.contracts",
        "contents": "Open a folder containing ODCS or Data Package v2 descriptors.\n[Refresh contracts](command:packata.refresh)"
      }
    ],
    "commands": [
      {
        "command": "packata.refresh",
        "title": "Refresh Contracts",
        "category": "Packata",
        "icon": "$(refresh)"
      },
      {
        "command": "packata.restart",
        "title": "Restart Language Server",
        "category": "Packata"
      },
      {
        "command": "packata.openSource",
        "title": "Open Source",
        "category": "Packata"
      },
      {
        "command": "packata.inspect",
        "title": "Inspect Contract",
        "category": "Packata"
      },
      {
        "command": "packata.validate",
        "title": "Validate…",
        "category": "Packata"
      },
      {
        "command": "packata.copyPath",
        "title": "Copy Logical Path",
        "category": "Packata"
      },
      {
        "command": "packata.selectView",
        "title": "View as: Canonical / Native",
        "category": "Packata",
        "icon": "$(list-tree)"
      },
      {
        "title": "Run Last Validation",
        "icon": "$(checklist)",
        "command": "packata.runLastValidation",
        "category": "Packata"
      },
      {
        "command": "packata.preview",
        "title": "Preview Resource Data…",
        "category": "Packata",
        "icon": "$(table)"
      },
      {
        "command": "packata.generateSchemaCode",
        "category": "Packata",
        "icon": "$(code)",
        "title": "Other Targets…"
      },
      {
        "title": "Other Formats…",
        "command": "packata.exportSchemaDocument",
        "category": "Packata"
      },
      {
        "title": "Arrow IPC…",
        "command": "packata.exportArrowSchema",
        "category": "Packata"
      },
      {
        "title": "Arrow Schema…",
        "category": "Packata C#",
        "command": "packata.generateArrowCsharp"
      },
      {
        "title": "Arrow Schema…",
        "category": "Packata Python",
        "command": "packata.generateArrowPython"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "packata.refresh",
          "when": "view == packata.contracts",
          "group": "navigation"
        },
        {
          "command": "packata.selectView",
          "when": "view == packata.contracts",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "packata.openSource",
          "when": "view == packata.contracts",
          "group": "1_source"
        },
        {
          "command": "packata.inspect",
          "when": "view == packata.contracts && (viewItem == contract || viewItem == asset || viewItem == previewAsset)",
          "group": "2_contract"
        },
        {
          "command": "packata.validate",
          "when": "view == packata.contracts && (viewItem == contract || viewItem == asset || viewItem == previewAsset)",
          "group": "2_contract"
        },
        {
          "command": "packata.copyPath",
          "when": "view == packata.contracts",
          "group": "3_copy"
        },
        {
          "command": "packata.preview",
          "when": "view == packata.contracts && viewItem == previewAsset",
          "group": "2_contract"
        },
        {
          "group": "2_contract",
          "submenu": "packata.exportSchema",
          "when": "view == packata.contracts && (viewItem == contract || viewItem == asset || viewItem == previewAsset) && packata.schemaDocumentsAvailable"
        },
        {
          "when": "view == packata.contracts && (viewItem == contract || viewItem == asset || viewItem == previewAsset) && packata.schemaGenerationAvailable",
          "group": "2_contract",
          "submenu": "packata.generateSchema"
        }
      ],
      "explorer/context": [
        {
          "when": "resourceScheme == file && (resourceExtname == .json || resourceExtname == .yaml || resourceExtname == .yml)",
          "command": "packata.validate",
          "group": "packata@1"
        },
        {
          "when": "resourceScheme == file && (resourceExtname == .json || resourceExtname == .yaml || resourceExtname == .yml)",
          "command": "packata.runLastValidation",
          "group": "packata@2"
        }
      ],
      "editor/context": [
        {
          "when": "resourceScheme == file && (resourceExtname == .json || resourceExtname == .yaml || resourceExtname == .yml)",
          "command": "packata.validate",
          "group": "packata@1"
        },
        {
          "when": "resourceScheme == file && (resourceExtname == .json || resourceExtname == .yaml || resourceExtname == .yml)",
          "command": "packata.runLastValidation",
          "group": "packata@2"
        }
      ],
      "packata.exportSchema": [
        {
          "group": "1_formats",
          "command": "packata.exportArrowSchema",
          "when": "packata.arrowIpcAvailable"
        },
        {
          "group": "2_other",
          "command": "packata.exportSchemaDocument",
          "when": "packata.schemaDocumentsAvailable"
        }
      ],
      "commandPalette": [
        {
          "when": "packata.arrowIpcAvailable",
          "command": "packata.exportArrowSchema"
        },
        {
          "when": "packata.schemaDocumentsAvailable",
          "command": "packata.exportSchemaDocument"
        },
        {
          "command": "packata.generateArrowCsharp",
          "when": "packata.arrowCsharpAvailable"
        },
        {
          "command": "packata.generateArrowPython",
          "when": "packata.arrowPythonAvailable"
        },
        {
          "when": "packata.schemaGenerationAvailable",
          "command": "packata.generateSchemaCode"
        }
      ],
      "packata.generateSchema": [
        {
          "when": "packata.arrowCsharpAvailable",
          "group": "1_languages",
          "submenu": "packata.generateCsharp"
        },
        {
          "when": "packata.arrowPythonAvailable",
          "group": "1_languages",
          "submenu": "packata.generatePython"
        },
        {
          "command": "packata.generateSchemaCode",
          "group": "2_other",
          "when": "packata.schemaGenerationAvailable"
        }
      ],
      "packata.generateCsharp": [
        {
          "command": "packata.generateArrowCsharp",
          "when": "packata.arrowCsharpAvailable"
        }
      ],
      "packata.generatePython": [
        {
          "command": "packata.generateArrowPython",
          "when": "packata.arrowPythonAvailable"
        }
      ]
    },
    "configuration": {
      "title": "Packata",
      "properties": {
        "packata.languageServer.path": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "description": "Optional absolute development server executable path. Empty uses the bundled self-contained server."
        },
        "packata.requestTimeout": {
          "type": "number",
          "default": 30000,
          "minimum": 1000,
          "description": "Maximum server request time in milliseconds."
        }
      }
    },
    "submenus": [
      {
        "id": "packata.exportSchema",
        "label": "Export Schema"
      },
      {
        "id": "packata.generateSchema",
        "label": "Generate Schema Code"
      },
      {
        "id": "packata.generateCsharp",
        "label": "C#"
      },
      {
        "id": "packata.generatePython",
        "label": "Python"
      }
    ]
  },
  "scripts": {
    "check": "tsc --noEmit",
    "compile": "npm run check && esbuild src/extension.ts --bundle --external:vscode --platform=node --format=cjs --outfile=dist/extension.js",
    "test": "node --test test/*.test.cjs",
    "package": "npm run compile && node scripts/package.mjs",
    "test:host": "node scripts/test-host.mjs"
  },
  "dependencies": {
    "vscode-languageclient": "10.1.1"
  },
  "devDependencies": {
    "@types/node": "26.5.1",
    "@types/vscode": "1.137.0",
    "@vscode/test-electron": "3.1.0",
    "@vscode/vsce": "3.9.2",
    "esbuild": "0.28.2",
    "typescript": "7.0.2",
    "yauzl": "3.4.0"
  },
  "overrides": {
    "@azure/identity": "4.13.0",
    "uuid": "11.1.1"
  }
}
